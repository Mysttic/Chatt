<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 i nowszy rozdziela kopię do chmury od przenosin na nowy telefon,
  a `allowBackup="false"` wyłącza tam tylko tę pierwszą. Blokujemy obie:
  klucz bazy siedzi w Keystore i nie da się go przenieść, więc przeniesiona
  baza byłaby po drugiej stronie nie do otwarcia.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
