<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Chatt.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Chatt"
    xmlns:views="clr-namespace:Chatt.Views"
    xmlns:sys="clr-namespace:System;assembly=netstandard"
    xmlns:system="clr-namespace:System;assembly=netstandard"
    Shell.FlyoutBehavior="Flyout">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:UI.ConversationsView}"
        Route="ListOfConversations" />

    <!--FlyoutHeader-->
    <Shell.FlyoutHeader>
        <Grid BackgroundColor="MidnightBlue" ColumnDefinitions="*,*">
            <ImageButton Grid.Column="0"
               Source="dotnet_bot.png"
               HeightRequest="100"
               Opacity="0.5"/>
            <Label Grid.Column="1"
               FontSize="Large" TextColor="White"
               FontAttributes="Bold" VerticalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <FormattedString.Spans>
                            <Span Text="Chatt"/>
                            <Span Text="{x:Static system:Environment.NewLine}"/>
                        </FormattedString.Spans>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </Grid>
    </Shell.FlyoutHeader>
    
    <Shell.FlyoutContent>
        <VerticalStackLayout Padding="10">
            <Label Text="SOME INFO AND COMMON SETTINGS HERE" Margin="0,10,0,20"/>
            
            <Label Text="Your nickname:"/>
            <Entry Text="Dante devilry" Margin="0,0,0,10"/>

            <Line BackgroundColor="LightGray" HeightRequest="3" Margin="1,5,0,10" HorizontalOptions="FillAndExpand"/>

            <Label Text="Welcome message:"/>
            <Editor Text="There will be your welcome message that will be send to other users in greeting call" Margin="0,0,0,10"/>

            <Line BackgroundColor="LightGray" HeightRequest="3" Margin="1,5,0,10" HorizontalOptions="FillAndExpand"/>

            <Button Text="Settings" HorizontalOptions="FillAndExpand" ContentLayout="{Binding views:SettingsView}"  Command="{Binding GoSettings}" />
        </VerticalStackLayout>
    </Shell.FlyoutContent>

    <!--FlyoutFooter-->
    <Shell.FlyoutFooter>
        <StackLayout BackgroundColor="#c1c1c1">
            <Label Text="Copyright | Mysttic"
              TextColor="Black"
              FontAttributes="Bold"
              HorizontalOptions="Center" />
            <Label Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='{0:MMMM dd, yyyy}'}"
              TextColor="Black"
              HorizontalOptions="Center" />
        </StackLayout>
    </Shell.FlyoutFooter>
    
</Shell>
