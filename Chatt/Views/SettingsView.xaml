<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chatt.Views.SettingsView"
             Title="SettingsPage">
    <StackLayout>
        <Grid ColumnDefinitions=".1*, *" VerticalOptions="Start" BackgroundColor="DodgerBlue">
            <ImageButton 
                Source="dotnet_bot.png" 
                HeightRequest="40" 
                WidthRequest="40" 
                Grid.Column="0" 
                HorizontalOptions="Start"
                Command="{Binding GoHome}"/>
            <Label 
                Text="Settings" 
                FontSize="26" 
                VerticalTextAlignment="Center"
                Grid.Column="1" 
                HorizontalOptions="CenterAndExpand"
                Margin="-70,0,0,0"/>
        </Grid>
        <VerticalStackLayout Margin="10">
            <Label Text="Your nickname:"/>
            <Entry Text="{Binding SettingsModel.Nickname}"/>

            <Label Text="Welcome message:" Margin="0,20,0,0"/>
            <Editor Text="{Binding SettingsModel.WelcomeMessage}" AutoSize="TextChanges"/>

            <Label Text="Custom port:" Margin="0,30,0,0"/>
            <Entry Text="{Binding SettingsModel.CustomPort}"/>

            <Label Text="Ip filter:" Margin="0,40,0,0"/>
            <Entry Text="{Binding SettingsModel.IpFilter}"/>

            <Label Text="Port filter:" Margin="0,20,0,0"/>
            <Entry Text="{Binding SettingsModel.PortFilter}"/>
        </VerticalStackLayout>

        <Frame 
                BackgroundColor="LightGray" 
                Padding="5" 
                Margin="10"
                HorizontalOptions="EndAndExpand" 
                VerticalOptions="EndAndExpand"
                WidthRequest="70" 
                HeightRequest="70" 
                CornerRadius="40">
            <ImageButton
                    Source="search_people.png"/>
        </Frame>
    </StackLayout>
    
    
</ContentPage>