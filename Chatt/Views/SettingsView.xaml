<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chatt.Views.SettingsView"
             Title="SettingsPage">
    <VerticalStackLayout>
        <Grid ColumnDefinitions=".1*, *" VerticalOptions="Start" BackgroundColor="Red">
            <ImageButton 
                Source="dotnet_bot.png" 
                HeightRequest="40" 
                WidthRequest="40" 
                Grid.Column="0" 
                HorizontalOptions="Start"
                Command="{Binding GoHome}"/>
            <Label Text="Title of the form" Grid.Column="1" HorizontalOptions="CenterAndExpand"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>