<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chatt.Views.ConversationView"
             Title="ConversationView">
    <ScrollView Orientation="Vertical">
        <StackLayout>
            <Grid ColumnDefinitions=".1*, *" VerticalOptions="Start" BackgroundColor="DodgerBlue">
                <ImageButton 
                    Source="dotnet_bot.png" 
                    HeightRequest="40" 
                    WidthRequest="40" 
                    Grid.Column="0" 
                    HorizontalOptions="Start"
                    Command="{Binding GoHome}"/>
                <Label 
                    Text="{Binding ConversationModel.User.NickName}" 
                    FontSize="26" 
                    VerticalTextAlignment="Center"
                    Grid.Column="1" 
                    HorizontalOptions="CenterAndExpand"
                    Margin="-70,0,0,0"/>
            </Grid>
            <CollectionView ItemsSource="{Binding ConversationMessages}" x:Name="collectionViewConversationMessages">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <StackLayout Margin="10" BackgroundColor="Gray" HeightRequest="70" Padding="10,0,10,0">
                            <Label Text="{Binding Message}"/>
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>

    </ScrollView>
</ContentPage>